# ---------------------------------------------------------------------------
# csmju-repair (ระบบแจ้งซ่อม) - ตัวอย่าง environment
# คัดลอกเป็น .env "ก่อน" รัน pnpm install  (ห้าม commit .env)
#   cp .env.example .env
# backend อ่าน backend/.env ก่อน แล้วจึงอ่าน .env ที่รากนี้
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3002

# ฐานข้อมูลของ subsystem นี้เท่านั้น - ห้ามชี้ไปที่ core_hub
# (docker compose up -d db จะสร้าง repair_db ที่พอร์ต 5434 ให้)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/repair_db

# Core Hub (ผู้ให้ identity)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับ name ใน Subsystem Registry
SUBSYSTEM_ID=csmju-repair

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# หลัง SSO callback ตั้งคุกกี้แล้วพาผู้ใช้ไปหน้าเว็บนี้ (ว่าง = ตอบ JSON แทนการ redirect)
FRONTEND_URL=http://localhost:3102

# ที่เก็บรูปถ่ายงานซ่อม (relative = นับจากโฟลเดอร์ backend/)
UPLOAD_DIR=uploads

# ---- frontend (Next.js) ----
# backend ที่ frontend ส่งต่อ /api และ /auth ไปให้ (rewrites ฝั่ง server)
BACKEND_URL=http://localhost:3002
# ปุ่ม "เข้าสู่ระบบผ่าน Core Hub" ในหน้าเว็บ พาไปที่นี่ (portal ของ Core Hub)
NEXT_PUBLIC_CORE_HUB_URL=http://localhost:3000
NEXT_PUBLIC_SUBSYSTEM_ID=csmju-repair
